{
  "schemaVersion": 1,
  "id": "teamcraft",
  "version": "${version}",
  "name": "TeamCraft",
  "description": "A Fabric mod that lets players create and join teams. Supports team creation, invites, team chat, and team management.",
  "authors": [
    "Pisces Cup"
  ],
  "contact": {},
  "license": "Apache-2.0",
  "icon": "assets/teamcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "io.github.piscescup.fabricmc.teamcraft.TeamcraftDataGenerator"
    ],
    "client": [
      "io.github.piscescup.fabricmc.teamcraft.client.TeamcraftClient"
    ],
    "modmenu": [
      "io.github.piscescup.fabricmc.teamcraft.compat.modmenu.TeamCraftModMenu"
    ],
    "main": [
      "io.github.piscescup.fabricmc.teamcraft.Teamcraft"
    ]
  },
  "depends": {
    "fabricloader": "${loader_dependency}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": "${java_dependency}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/Piscescup/TeamCraft/releases"
      },
      "update_checker": true
    }
  }
}
